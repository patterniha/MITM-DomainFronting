  "remarks": "MITM-DomainFronting-v24-fragB",

  "version": {
    "min": "26.11.23"
  },

  "log": {
    "loglevel": "warning", "dnsLog": false, "access": "none"
  },

  "policy": {
    "levels": {
      "0": {
        "uplinkOnly": 0,
        "downlinkOnly": 0
      },
      "12": {
        "uplinkOnly": 0,
        "downlinkOnly": 0,
        "connIdle": 12
      }
    }
  },

  "dns":{
    "hosts": {
      "dns.redirect": ["2606:4700:4700::1111", "2606:4700:4700::1001", "1.1.1.1", "1.0.0.1"],
      "cloudflare.redirect": ["2606:4700:4408::ac40:9bd1", "2a06:98c1:3122::", "2a06:98c1:3101::6812:202f", "2a06:98c1:3123::", "188.114.99.0"],
      "x.redirect": ["188.114.99.0"],
      "fastly.redirect": ["2a04:4e42:200::223", "2a04:4e42::223", "2a04:4e42:400::223", "2a04:4e42:600::223", "151.101.64.223", "151.101.0.223", "151.101.128.223", "151.101.192.223"]
    },
    "servers": [
      {
        "address": "fakedns",
        "domains": ["domain:ir", "geosite:private", "geosite:category-ir", "geosite:category-ai-cn", "geosite:category-ai-!cn", "geosite:category-ai-ru", "domain:cloudflare.com", "geosite:category-speedtest", "geosite:category-ip-geo-detect"]
      },
      {
        "tag": "no-filter-dns",
        "address": "h2c+one://one.one.one.one/dns-query",
        "timeoutMs": 12000,
        "finalQuery": true
      },
      {
        "tag": "domestic-dns",
        "address": "localhost",
        "domains": ["domain:ir", "geosite:private", "geosite:category-ir", "geosite:category-ai-cn", "geosite:category-ai-!cn", "geosite:category-ai-ru", "domain:cloudflare.com", "geosite:category-speedtest", "geosite:category-ip-geo-detect"],
        "timeoutMs": 12000,
        "finalQuery": true
      }
    ],
    "queryStrategy": "UseSystem",
    "useSystemHosts": true,
	"serveStale": true,
    "skipHostsWhenFakeEnable": true
  },

  "inbounds": [
    {
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "mixed",
      "sniffing": {
        "enabled": true,
        "destOverride": ["fakedns", "tls", "http", "quic"],
        "routeOnly": false
      },
      "settings": {
        "udp": true,
        "ip": "127.0.0.1"
      }
    },
    {
      "tag": "tls-decrypt-h11",
      "listen": "127.0.0.1",
      "port": 11666,
      "protocol": "tunnel",
      "settings": {
        "network": "tcp",
        "rewritePort": 443,
        "followRedirect": true
      },
      "streamSettings": {
        "security": "tls",
        "tlsSettings": {
          "alpn": ["http/1.1"],
          "certificates": [
            {
              "usage": "issue",
              "certificateFile": "mycert.crt",
              "keyFile": "mycert.key"
            }
          ]
        }
      }
    },
    {
      "tag": "tls-decrypt-h211",
      "listen": "127.0.0.1",
      "port": 11777,
      "protocol": "tunnel",
      "settings": {
        "network": "tcp",
        "rewritePort": 443,
        "followRedirect": true
      },
      "streamSettings": {
        "security": "tls",
        "tlsSettings": {
          "alpn": ["h2","http/1.1"],
          "certificates": [
            {
              "usage": "issue",
              "certificateFile": "mycert.crt",
              "keyFile": "mycert.key"
            }
          ]
        }
      }
    }
  ],

